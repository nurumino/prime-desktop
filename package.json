{
  "name": "prime-desktop",
  "version": "0.1.0",
  "description": "Prime Desktop — a macOS desktop app for Prime Agent",
  "main": "out/main/index.js",
  "private": true,
  "type": "module",
  "overrides": {
    "nanoid": "3.3.18"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "postinstall": "node scripts/fix-node-pty.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:previews": "electron scripts/check-preview-memory.mjs",
    "test:runtime": "node scripts/check-agent-runtime.mjs",
    "test:watch": "vitest",
    "check:release": "node scripts/check-release.mjs",
    "package": "npm run check:release && npm run build && electron-builder --mac"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "3dmol": "^2.5.5",
    "docx-preview": "^0.4.0",
    "katex": "^0.18.4",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^6.2.108",
    "pptx-browser": "^4.1.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
